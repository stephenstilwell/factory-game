extends RefCounted
const Saves = preload("res://scripts/persistence/save_service.gd")
const Simulation = preload("res://scripts/simulation/simulation.gd")
static func world() -> RefCounted:
	var game = preload("res://tests/town_services_tests.gd").town()
	game.frontier.sites.orchard.discovered = true
	game.frontier.sites.orchard.claimed = true
	game.player_position = Vector2(game.frontier.port("orchard")) + Vector2.ONE * 0.5
	game.previous_position = game.player_position
	game.player.add("stone", 30)
	game.player.add("plank", 30)
	game.player.add("coal", 10)
	return game

static func run(test: SceneTree) -> void:
	var game := world()
	var garden: RefCounted = game.orchard_project
	var credits: int = game.settlements.credits
	test.check(garden.restore_bed(game) and garden.beds == 1 and game.settlements.credits == credits - 15 and game.player.count("stone") == 20, "Orchard restoration consumes its exact construction cost and credits")
	var saved := Saves.decode(JSON.parse_string(JSON.stringify(Saves.encode(game))))
	test.check(saved.error.is_empty() and saved.world.orchard_project.beds == 1, "Paid growing beds reconcile and save")
	garden.supply(game)
	garden.step(game)
	test.check(garden.growth_ticks == 449 and garden.inventory.total() == 0, "Starting growth commits one fuel and plank per active bed")
	test.check(garden.restore_bed(game), "A second bed can be restored while a paid crop grows")
	saved = Saves.decode(JSON.parse_string(JSON.stringify(Saves.encode(game))))
	test.check(saved.error.is_empty() and saved.world.orchard_project.growing_beds == 1 and saved.world.orchard_project.growth_ticks == 449, "In-flight crops preserve their paid bed count when saving after an upgrade")
	for i in range(449): garden.step(game)
	test.check(garden.output.count("foraged_food") == 4, "Upgrading beds mid-crop cannot inflate the committed yield")
	garden.collect(game)
	test.check(game.player.count("foraged_food") == 4 and garden.output.total() == 0, "Collect harvest transfers physical produce to the pack")
	var market: RefCounted = game.settlements.sites.trading_post.inventory
	market.add("foraged_food", 3)
	for i in range(20): garden.step(game)
	test.check(market.count("foraged_food") == 3 and garden.sale_ticks == 0, "Partial produce loads never get consumed by a failed sale")
	game.player_position = Vector2(game.settlements.sites.trading_post.port()) + Vector2(-0.5, 0.5)
	test.check(garden.deliver_market(game), "Fresh produce can be manually supplied to the market")
	credits = game.settlements.credits
	for i in range(300): garden.step(game)
	test.check(game.settlements.credits == credits + 6 and game.settlements.produce_sales == 1 and market.count("foraged_food") == 3, "Only complete funded market loads earn trade income")
	saved = Saves.decode(JSON.parse_string(JSON.stringify(Saves.encode(game))))
	test.check(saved.error.is_empty(), "Produce buffers, bed spending and sales reconcile across saving")
	var malformed := Saves.encode(game)
	malformed.settlements.produce_sales += 1
	test.check(not Saves.decode(malformed).error.is_empty(), "Unfunded produce income is rejected on load")
	var old := world()
	var old_data := Saves.encode(old)
	old_data.erase("orchard_project")
	old_data.settlements.erase("garden_beds")
	old_data.settlements.erase("produce_sales")
	test.check(not Saves.decode(old_data).error.is_empty(), "Missing garden state is rejected")
	var full := world()
	full.orchard_project.restore_bed(full)
	full.orchard_project.supply(full)
	full.orchard_project.output.add("foraged_food", 24)
	full.orchard_project.step(full)
	test.check(full.orchard_project.growth_ticks == 0 and full.orchard_project.inventory.total() == 2, "Full harvest storage stops growth before consuming inputs")
	full.orchard_project.output.remove("foraged_food", 24)
	full.orchard_project.step(full)
	full.settlements.sites.trading_post.health = 0
	full.orchard_project.step(full)
	test.check(full.orchard_project.growth_ticks == 449, "Closed town services pause a funded crop without losing it")
	var automated := world()
	automated.orchard_project.restore_bed(automated)
	var port: Vector2i = automated.frontier.port("orchard")
	var chest = automated.spawn("chest", port + Vector2i(-2, 0), 0)
	chest.inventory.add("coal", 1)
	chest.inventory.add("plank", 1)
	automated.spawn("inserter", port + Vector2i.LEFT, 0)
	for i in range(20): Simulation._inserters(automated)
	test.check(automated.orchard_project.inventory.total() == 2 and chest.inventory.total() == 0, "Existing inserters supply orchard inputs")
	for i in range(450): automated.orchard_project.step(automated)
	automated.spawn("inserter", port + Vector2i.UP, 3)
	var output = automated.spawn("chest", port + Vector2i.UP * 2, 0)
	for i in range(30): Simulation._inserters(automated)
	test.check(output.inventory.count("foraged_food") == 4 and automated.orchard_project.output.total() == 0, "Inserters extract harvest through the orchard hatch")
	var market_port: Vector2i = automated.settlements.sites.trading_post.port()
	var shipment = automated.spawn("chest", market_port + Vector2i(-2, 0), 0)
	shipment.inventory.add("foraged_food", 4)
	automated.spawn("inserter", market_port + Vector2i.LEFT, 0)
	for i in range(30): Simulation._inserters(automated)
	test.check(automated.settlements.sites.trading_post.inventory.count("foraged_food") == 4 and shipment.inventory.total() == 0, "Inserters deliver orchard produce to the market receiver")
	var legacy := world()
	legacy.player.add("timber", 1)
	test.check(legacy.early.enabled and legacy.craft("plank") and legacy.content_available("lumber_camp"), "Industrial towns retain forestry and regional plank crafting")

static func ui(test: SceneTree) -> void:
	var game := world()
	var panel := preload("res://scripts/ui/frontier_panel.gd").new()
	test.root.add_child(panel)
	panel.open_panel(game, "orchard")
	test.check(panel.orchard_box.visible and not panel.bed_button.disabled, "Recovered orchard shows its restoration project")
	panel.bed_button.pressed.emit()
	test.check(game.orchard_project.beds == 1 and "45s" in panel.orchard_text.text, "Orchard UI restores beds and explains growing time")
	panel.orchard_supply.pressed.emit()
	test.check(game.orchard_project.inventory.total() == 2, "Orchard UI supplies actual growing materials")
	panel.open_panel(game, "quarry")
	test.check(not panel.orchard_box.visible, "Growing controls stay in their own biome")
	panel.queue_free()
	await test.process_frame
