extends RefCounted
const World = preload("res://scripts/simulation/world.gd")
const Saves = preload("res://scripts/persistence/save_service.gd")
const Navigation = preload("res://scripts/model/navigation.gd")
const Diagnostics = preload("res://scripts/simulation/factory_diagnostics.gd")

static func run(test: SceneTree) -> void:
	var navigation := Navigation.new()
	var first := navigation.add(Vector2i(-19, 45), "  North\nridge ")
	test.check(first > 0 and navigation.target().title == "North ridge", "Named map pins normalize titles and support negative coordinates")
	navigation.track(0)
	test.check(navigation.target().is_empty() and navigation.pins.size() == 1, "Stopping guidance preserves saved pins")
	navigation.track(first)
	navigation.rename(first, "Copper works")
	var restored := Navigation.new()
	test.check(restored.restore(JSON.parse_string(JSON.stringify(navigation.serialize()))) and restored.target().title == "Copper works", "Navigation survives a JSON round trip")
	var snapshot := restored.serialize()
	for bad in [null, [], {"pins": [{}]}, {"pins": [{"id": 1, "x": 0.5, "y": 0, "title": "Bad"}]}, {"active": 1}, {"next_id": 0}, {"pins": [{"id": 1, "x": 0, "y": 0, "title": "Valid"}], "next_id": 1}]:
		test.check(not restored.restore(bad) and restored.serialize() == snapshot, "Malformed navigation is rejected without changing live pins")
	for i in range(31): navigation.add(Vector2i(i, i))
	test.check(navigation.add(Vector2i.ZERO) == 0 and navigation.pins.size() == 32, "Pin count is bounded")
	navigation.remove(navigation.active)
	test.check(navigation.target().is_empty() and navigation.pins.size() == 31, "Removing an active pin clears guidance")
	var world := World.new()
	world.start()
	world.navigation.add(Vector2i(22, 12), "Camp")
	var loaded := Saves.decode(JSON.parse_string(JSON.stringify(Saves.encode(world))))
	test.check(loaded.error.is_empty() and loaded.world.navigation.target().title == "Camp", "Map pins persist in world saves")
	var old := Saves.encode(world)
	old.erase("navigation")
	test.check(Saves.decode(old).error.is_empty(), "Older saves without map pins still load")
	world.start()
	test.check(world.navigation.pins.is_empty(), "Starting a new world clears old map pins")

	var factory := World.new()
	factory.player_position = Vector2(18.5, 18.5)
	factory.player.add("belt", 1)
	factory.player.add("iron_plate", 10)
	for cell in [Vector2i(19, 18), Vector2i(20, 18), Vector2i(20, 19), Vector2i(21, 19), Vector2i(100, 100)]:
		factory.plans.place_single(factory, "belt", cell, 0)
	var report: Dictionary = factory.plans.supply_report(factory)
	test.check(report.rows.belt.needed == 4 and report.rows.belt.pack == 1 and report.rows.belt.missing == 3 and report.distant == 1, "Plan supplies distinguish nearby demand, pack stock and distant ghosts")
	test.check(report.ready == 1, "Ready count does not allocate the same building item twice")
	test.check(factory.plans.craft_missing(factory, "belt") and factory.craft_queue.size() == 2 and factory.player.count("iron_plate") == 8, "Craft shortages respects multi-output recipes and reserves real materials")
	report = factory.plans.supply_report(factory)
	test.check(report.rows.belt.queued == 4 and report.rows.belt.missing == 0 and not factory.plans.craft_missing(factory, "belt"), "Already queued outputs prevent duplicate shortage crafts")
	factory.cancel_all_crafts()
	test.check(factory.plans.supply_report(factory).rows.belt.missing == 3 and factory.player.count("iron_plate") == 10, "Cancelled crafts restore shortages and ingredients")
	test.check(factory.plans.supply_report(factory, false).rows.belt.needed == 5, "All-plan view includes distant demand")
	factory.spawn("chest", Vector2i(20, 18), 0)
	test.check(factory.plans.supply_report(factory).blocked == 1, "Occupied construction ghosts explain blocked work")
	factory.player.remove("belt", 1)
	test.check(factory.plans.supply_report(factory).blocked == 1 and factory.plans.supply_report(factory).ready == 0, "Blocked locations remain visible even when pack stock is empty")
	var before: Dictionary = factory.player.contents.duplicate()
	factory.plans.supply_report(factory)
	test.check(factory.player.contents == before, "Supply reports never consume goods")
	var near = factory.spawn("furnace", Vector2i(19, 20), 0)
	near.status = "No fuel"
	var far = factory.spawn("furnace", Vector2i(50, 50), 0)
	far.status = "No fuel"
	var working = factory.spawn("assembler", Vector2i(18, 19), 0)
	working.status = "Working"
	var stalls := Diagnostics.stalled(factory)
	test.check(stalls.size() == 2 and stalls[0].id == near.id, "Diagnostics locate the nearest actual stall and ignore productive machinery")
	near.health = 0
	test.check(Diagnostics.stalled(factory)[0].reason == "Needs repair", "Broken machines report repair needs")

static func ui(test: SceneTree) -> void:
	var world := World.new()
	world.start()
	var map := preload("res://scripts/ui/resource_survey.gd").new()
	test.root.add_child(map)
	map.open(world)
	map.pin_name.text = "Home grove"
	map.chart.pin_title = map.pin_name.text
	map.chart.add_pin_at(map.chart.size * 0.5)
	test.check(world.navigation.target().title == "Home grove" and map.pin_list.item_count == 1, "Chart creates named pins on explored land")
	var count: int = world.navigation.pins.size()
	map.chart.add_pin_at(Vector2(-10000, -10000))
	test.check(world.navigation.pins.size() == count, "Map does not place pins in unexplored territory")
	map.pin_actions[1].pressed.emit()
	test.check(world.navigation.target().is_empty(), "Map tracking toggle clears guidance")
	map.pin_actions[1].pressed.emit()
	test.check(not world.navigation.target().is_empty(), "Saved pins can be tracked again")
	map.pin_name.text = "Renamed camp"
	map.pin_actions[0].pressed.emit()
	test.check(world.navigation.target().title == "Renamed camp", "Map rename updates tracked destinations")
	map.pin_actions[2].pressed.emit()
	test.check(world.navigation.pins.is_empty(), "Map removes saved pins")
	map.queue_free()
	var factory := World.new()
	var stalled = factory.spawn("furnace", Vector2i(19, 20), 0)
	stalled.status = "No fuel"
	var panel := preload("res://scripts/ui/factory_panel.gd").new()
	test.root.add_child(panel)
	panel.open_panel(factory, "production")
	test.check(not panel.locate_button.disabled, "Production view enables actionable diagnostics")
	panel.locate_button.pressed.emit()
	test.check(not panel.visible and factory.navigation.target().cell == stalled.cell, "Locate closes the panel and starts persistent compass guidance")
	panel.open_panel(factory, "production")
	panel.locate_button.pressed.emit()
	test.check(factory.navigation.pins.size() == 1, "Repeated diagnostics reuse the same machine pin")
	panel.open_panel(factory, "plans")
	test.check(panel.nearby_plans.button_pressed, "Plan checklist defaults to nearby work")
	panel.queue_free()
	await test.process_frame
